{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tamil-worship-song",
  "main": "src/worker.ts",
  "compatibility_date": "2026-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": false
  },
  "observability": {
    "enabled": true
  }
}

