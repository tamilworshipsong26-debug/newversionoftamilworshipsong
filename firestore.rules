rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Live Broadcast Rooms (OBS / Projector synchronization)
    match /rooms/{roomId} {
      allow read: if true; // OBS and Projector can read in real-time without credentials
      allow create, update: if true; // Allows mobile/tablet/desktop console controllers
      allow delete: if isAdmin();
    }

    // Weekly Service Setlists (Cue Sheets)
    match /setlists/{setlistId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && 
        (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // Mistake / Typo Reports
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if true; // Community submissions allowed offline/online
      allow update, delete: if isAdmin();
    }

    // Cloud Hymn Directory (Custom additions & updates)
    match /hymns/{hymnId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Admin Role Mapping
    match /admins/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if isAdmin();
    }
  }
}

